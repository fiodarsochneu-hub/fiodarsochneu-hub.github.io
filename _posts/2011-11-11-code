data class WordCard(
    val id: Int,
    val english: String,
    val translations: List<String>,
    val transcription: String
)

@Composable
fun CardScreen() {
    val context = LocalContext.current
    val sharedPreferences = remember { context.getSharedPreferences("Prefs", Context.MODE_PRIVATE) }
    val initialWords = remember {
        val learned = sharedPreferences.getStringSet("learned_ids", emptySet()) ?: emptySet()
        val filtered = WordsDatabase.getTopWords().filter { it.id.toString() !in learned }
        mutableStateListOf<WordCard>().apply { addAll(filtered.shuffled()) }
    }
    var currentIndex by remember { mutableStateOf(0) }
    var isFlipped by remember { mutableStateOf(false) }

    LaunchedEffect(currentIndex) { isFlipped = false }

    val rotation by animateFloatAsState(
        targetValue = if (isFlipped) 180f else 0f,
        animationSpec = tween(350),
        label = "Flip"
    )

    if (initialWords.isEmpty()) {
        Box(modifier = Modifier.fillMaxSize(), contentAlignment = Alignment.Center) {
            Column(horizontalAlignment = Alignment.CenterHorizontally) {
                Text("🎉 Все слова выучены!", fontSize = 24.sp, fontWeight = FontWeight.Bold)
                Spacer(modifier = Modifier.height(16.dp))
                Button(onClick = {
                    sharedPreferences.edit().remove("learned_ids").apply()
                    initialWords.addAll(WordsDatabase.getTopWords().shuffled())
                    currentIndex++
                }) { Text("Начать заново") }
            }
        }
        return
    }

    val currentCard = initialWords.firstOrNull()
    if (currentCard != null) {
        Column(
            modifier = Modifier.fillMaxSize().padding(24.dp),
            horizontalAlignment = Alignment.CenterHorizontally,
            verticalArrangement = Arrangement.SpaceBetween
        ) {
            Column(horizontalAlignment = Alignment.CenterHorizontally, modifier = Modifier.padding(top = 16.dp)) {
                Text("Осталось карточек: ${initialWords.size}", fontSize = 16.sp)
                val totalLearned = WordsDatabase.getTopWords().size - initialWords.size
                Text("Выучено: $totalLearned из ${WordsDatabase.getTopWords().size}", fontSize = 14.sp, color = MaterialTheme.colorScheme.outline)
            }

            Card(
                modifier = Modifier
                    .fillMaxWidth(0.85f)
                    .aspectRatio(0.7f)
                    .graphicsLayer { rotationY = rotation; cameraDistance = 12f * density }
                    .clickable { isFlipped = !isFlipped },
                elevation = CardDefaults.cardElevation(6.dp),
                colors = CardDefaults.cardColors(containerColor = MaterialTheme.colorScheme.surfaceVariant)
            ) {
                Box(modifier = Modifier.fillMaxSize(), contentAlignment = Alignment.Center) {
                    if (rotation <= 90f) {
                        Text(currentCard.english, fontSize = 38.sp, fontWeight = FontWeight.Bold)
                    } else {
                        Column(
                            modifier = Modifier
                                .graphicsLayer { rotationY = 180f }
                                .padding(24.dp),
                            horizontalAlignment = Alignment.CenterHorizontally
                        ) {
                            Text(
                                text = currentCard.transcription,
                                fontSize = 24.sp,
                                color = MaterialTheme.colorScheme.outline,
                                textAlign = TextAlign.Center
                            )

                            Spacer(modifier = Modifier.height(28.dp))

                            val annotatedTranslation = buildAnnotatedString {
                                currentCard.translations.forEachIndexed { index, translation ->
                                    when (index) {
                                        0 -> {
                                            withStyle(
                                                style = SpanStyle(
                                                    fontSize = 26.sp,
                                                    fontWeight = FontWeight.Bold,
                                                    color = MaterialTheme.colorScheme.onSurfaceVariant,
                                                    textDecoration = TextDecoration.combine(
                                                        listOf(TextDecoration.Underline, TextDecoration.Underline)
                                                    )
                                                )
                                            ) {
                                                append(translation)
                                            }
                                        }
                                        1 -> {
                                            append("\n")
                                            withStyle(style = SpanStyle(fontSize = 20.sp, fontWeight = FontWeight.Medium)) {
                                                append(translation)
                                            }
                                        }
                                        2 -> {
                                            append("\n")
                                            withStyle(style = SpanStyle(fontSize = 17.sp, color = MaterialTheme.colorScheme.onSurface.copy(alpha = 0.8f))) {
                                                append(translation)
                                            }
                                        }
                                        else -> {
                                            append("\n")
                                            withStyle(style = SpanStyle(fontSize = 15.sp, color = MaterialTheme.colorScheme.outline)) {
                                                append(translation)
                                            }
                                        }
                                    }
                                }
                            }

                            Text(
                                text = annotatedTranslation,
                                textAlign = TextAlign.Center,
                                lineHeight = 28.sp
                            )
                        }
                    }
                }
            }

            Row(modifier = Modifier.fillMaxWidth().padding(bottom = 32.dp), horizontalArrangement = Arrangement.SpaceEvenly) {
                Button(
                    onClick = {
                        if (initialWords.size > 1) {
                            val word = initialWords.removeAt(0)
                            val pos = if (initialWords.size >= 5) 5 else initialWords.size
                            initialWords.add(pos, word)
                        }
                        currentIndex++
                    },
                    colors = ButtonDefaults.buttonColors(containerColor = MaterialTheme.colorScheme.error),
                    modifier = Modifier.width(130.dp).height(50.dp)
                ) { Text("Не знаю") }

                Button(
                    onClick = {
                        val word = initialWords.removeAt(0)
                        val learned = sharedPreferences.getStringSet("learned_ids", emptySet()) ?: emptySet()
                        sharedPreferences.edit().putStringSet("learned_ids", learned.toMutableSet().apply { add(word.id.toString()) }).apply()
                        currentIndex++
                    },
                    colors = ButtonDefaults.buttonColors(containerColor = MaterialTheme.colorScheme.primary),
                    modifier = Modifier.width(130.dp).height(50.dp)
                ) { Text("Знаю") }
            }
        }
    }
}

